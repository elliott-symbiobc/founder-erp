# Founder ERP — host nginx server block.
#
# Installed by scripts/setup-host.sh, which substitutes __DOMAIN__ and
# __PORT__ and then lets certbot add the TLS directives.
#
# Only the frontend is proxied. The API is not published on the host at all:
# the frontend proxy is the authentication boundary, and the API trusts the
# identity headers it sets. Never add a location block for the API here.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot rewrites this to a redirect once a certificate exists.
    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # NextAuth builds callback URLs from this. Without it, sign-in
        # redirects to http:// and the session cookie is dropped.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";

        # Attachments, marketing assets and portal uploads.
        client_max_body_size 50M;

        proxy_connect_timeout 60s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }
}
