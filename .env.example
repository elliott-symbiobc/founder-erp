# Founder ERP configuration. Copy to .env and fill in.
#   cp .env.example .env && ./scripts/gen-secrets.sh
# gen-secrets.sh fills in every REQUIRED value below with a fresh random secret.

# ── Identity of this instance ────────────────────────────────────────────────
INSTANCE=founder_erp
COMPOSE_PROJECT_NAME=founder_erp
# Host port the frontend is published on, bound to 127.0.0.1. Give each
# instance on a shared host a different port; nginx proxies to it.
FRONTEND_PORT=8110
TZ=UTC

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
POSTGRES_USER=founder_erp
POSTGRES_DB=founder_erp
POSTGRES_PASSWORD=

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Shared between the API and the frontend proxy. The frontend proxy is the
# authentication boundary: it forwards the signed-in user as an X-User-Id
# header, and the API honours that header only when the caller also presents
# this secret. Without it, anything able to reach the API can assert any user.
INTERNAL_API_SECRET=

# Session signing key for NextAuth.
NEXTAUTH_SECRET=

# Encrypts per-user integration API keys at rest.
USER_KEY_SECRET=

# ── Public URL (REQUIRED) ────────────────────────────────────────────────────
# The address people actually visit. Must match what nginx serves.
NEXTAUTH_URL=https://erp.example.com

# ── Optional integrations ────────────────────────────────────────────────────
# Every module below degrades gracefully when its key is absent.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only used with `--profile full` (Celery worker + Redis).
# REDIS_URL=redis://redis:6379/0
