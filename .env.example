DB_PASSWORD=change_this_to_a_strong_password
ANTHROPIC_API_KEY=sk-ant-your-key-here
SECRET_KEY=generate_64_random_hex_chars
NEXTAUTH_SECRET=generate_32_random_hex_chars
NEXTAUTH_URL=https://erp.example.com
S2_API_KEY=your-semantic-scholar-api-key
ATCC_API_KEY=your-atcc-genome-portal-api-key
GRANOLA_API_KEY=your-granola-api-key
USDA_API_KEY=DEMO_KEY

# antiSMASH BGC annotation
ANTISMASH_CONDA_ENV=antismash
ANTISMASH_DB_DIR=/data/antismash_db
ANTISMASH_OUTPUT_DIR=/opt/openerp/antismash_results

# Shared between the API and the frontend proxy. The API only honours the
# identity headers the proxy sets (X-User-Id and friends) when a request also
# carries this, so without it anything able to reach the API directly could
# assert any user. Required in production; generate with `openssl rand -hex 32`.
INTERNAL_API_SECRET=
